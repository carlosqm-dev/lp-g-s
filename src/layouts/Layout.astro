---
import '../styles/global.css';
import Preloader from '../components/layout/Preloader.astro';
import Header from '../components/layout/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <script>
    // Evita que el navegador restaure el scroll al recargar: cada carga
    // debe arrancar desde el hero, no a mitad de página.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <!-- Galvji no tiene licencia web. Barlow Condensed conserva el gesto
       industrial de la marca e IBM Plex Sans mantiene legibilidad. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#002A41" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/brand/logo-horizontal.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="878" />
  <meta property="og:image:height" content="428" />
  <meta property="og:image:alt" content="Logo de G&S Conexiones Estratégicas" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content="/brand/logo-horizontal.png" />
  <meta name="twitter:image:alt" content="Logo de G&S Conexiones Estratégicas" />
  <!-- Astro View Transitions (ViewTransitions/ClientRouter) se omite a
       proposito: aporta valor entre paginas distintas, y G&S es un
       one-pager puro (un solo index.astro). -->
</head>
<body class="bg-background font-body text-text">
  <noscript><style>#preloader { display: none !important; }</style></noscript>
  <Preloader />
  <Header />
  <slot />
</body>
</html>

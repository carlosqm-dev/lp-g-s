---
import '../styles/global.css';
import Preloader from '../components/layout/Preloader.astro';
import Header from '../components/layout/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <script>
    // Evita que el navegador restaure el scroll al recargar: cada carga
    // debe arrancar desde el hero, no a mitad de página.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Tipografia de marca (Poppins/Lato, ver design-system/tokens.json).
       Galvji del manual de marca no tiene licencia web; Poppins fue la
       alternativa aprobada por el cliente. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Lato:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content="/og-default.png" />
  <!-- Astro View Transitions (ViewTransitions/ClientRouter) se omite a
       proposito: aporta valor entre paginas distintas, y G&S es un
       one-pager puro (un solo index.astro). -->
</head>
<body class="bg-background text-text font-body">
  <Preloader />
  <Header />
  <slot />
</body>
</html>

---
import { getEntry } from 'astro:content';
import { impactCards, impactHighlight } from '../../data/impact';

const { data } = await getEntry('landing', '06-impact');
---
<section id="impacto" class="gsap-section industrial-grid overflow-hidden bg-primary py-20 text-background md:py-32" data-section="impact">
  <div class="section-shell">
    <div class="border-b border-background/20 pb-9 text-center">
      <h2 class="display-title mx-auto max-w-[16ch] text-6xl text-background md:text-8xl lg:text-[6.75rem]">{data.headline}</h2>
      {data.subheadline && <p class="mx-auto mt-6 max-w-[58ch] text-base leading-relaxed text-background/70 md:text-xl">{data.subheadline}</p>}
    </div>

    <div class="mt-8 grid gap-px bg-background/15 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="impact-copy relative overflow-hidden bg-primary p-5 md:p-9">
        <span aria-hidden="true" class="absolute -right-10 -top-14 font-heading text-[13rem] font-bold leading-none text-background/[0.035]">PET</span>
        <p class="relative max-w-[20ch] font-heading text-[clamp(2.25rem,5.2vw,4.5rem)] font-semibold uppercase leading-[0.92] tracking-[-0.03em]">
          {impactHighlight.before}<span class="text-accent">{impactHighlight.accent1}</span>{impactHighlight.middle}<span class="text-accent">{impactHighlight.accent2}</span>{impactHighlight.after}
        </p>
        <span class="relative mt-7 inline-flex border border-accent/60 px-3 py-2 text-[9px] font-semibold uppercase tracking-[0.12em] text-accent">
          {impactHighlight.note}
        </span>
      </div>

      <div class="impact-visual relative min-h-[23rem] overflow-hidden bg-[#001c2c] md:min-h-[32rem]">
        <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_65%_45%,rgba(148,194,61,.5),transparent_7%),radial-gradient(circle_at_40%_58%,rgba(243,241,234,.18),transparent_5%),radial-gradient(circle_at_73%_70%,rgba(243,241,234,.22),transparent_6%)]"></div>
        <div aria-hidden="true" class="absolute inset-x-[14%] bottom-[12%] top-[12%] rotate-[-8deg] border border-accent/40"></div>
        <div class="absolute inset-x-5 bottom-5 flex items-end justify-between border-t border-background/20 pt-4 text-[9px] font-semibold uppercase tracking-[0.15em] text-background/50">
          <span>Material recuperado</span><span class="text-accent">Ciclo activo ↻</span>
        </div>
      </div>
    </div>

    <div class="mt-px grid gap-px bg-background/15 md:grid-cols-2">
      {impactCards.map((card) => (
        <article class="impact-card relative bg-primary p-5 md:p-7">
          <div class="flex items-start">
            <span class={`border px-2 py-1 text-[9px] font-semibold uppercase tracking-[0.12em] ${card.tagVariant === 'confirmed' ? 'border-accent bg-accent text-primary' : 'border-accent/60 text-accent'}`}>{card.tag}</span>
          </div>
          <div class="mt-10 font-heading text-6xl font-bold leading-none text-background md:text-7xl">{card.number}</div>
          <div class="mt-3 max-w-[28ch] text-sm text-background/70">{card.label}</div>
          <div class="mt-8 border-t border-background/20 pt-3 text-[10px] leading-relaxed text-background/45">{card.method}</div>
        </article>
      ))}
    </div>
  </div>
</section>

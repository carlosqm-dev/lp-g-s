---
import { getEntry } from 'astro:content';
const { data } = await getEntry('landing', '07-final-cta');
---
<section id="cta-final" class="gsap-section px-6 md:px-16 py-32 text-center" data-section="final-cta">
  <h2 class="font-heading text-3xl md:text-5xl max-w-2xl mx-auto">{data.headline}</h2>
  {data.cta_label && (
    <a href={data.cta_href} class="mt-10 inline-flex items-center rounded-md bg-primary px-8 py-4 text-lg text-background transition-base hover:opacity-90">
      {data.cta_label}
    </a>
  )}
</section>

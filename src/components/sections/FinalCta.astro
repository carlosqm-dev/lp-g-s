---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';

const { data } = await getEntry('landing', '09-final-cta');
---
<section id="contacto" class="gsap-section overflow-hidden bg-accent py-20 text-primary md:py-28" data-section="final-cta">
  <div class="section-shell">
    <div class="relative isolate">
      <img
        src="/brand/isotipo-black.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-[18%] top-1/2 -z-10 h-auto w-[min(72vw,34rem)] -translate-x-1/2 -translate-y-1/2 object-contain opacity-[0.055] md:left-[20%]"
      />
      <h2 class="display-title mx-auto whitespace-pre text-center text-[clamp(1.62rem,8.2vw,6.8rem)]">{data.headline}</h2>
    </div>
    {data.subheadline && <p class="body-copy mx-auto mt-6 max-w-[44ch] text-center text-primary/70">{data.subheadline}</p>}
    {data.cta_label && (
      <div class="mt-9 flex justify-center">
        <a
          href={contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-lift inline-flex min-h-14 items-center justify-center whitespace-nowrap bg-primary px-6 font-semibold text-background md:px-9"
        >
          {data.cta_label}
        </a>
      </div>
    )}
  </div>
</section>

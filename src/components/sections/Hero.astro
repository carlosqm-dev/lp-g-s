---
import { getEntry } from 'astro:content';
const { data } = await getEntry('landing', '01-hero');
---
<section id="hero" class="gsap-section min-h-screen flex flex-col justify-center px-6 md:px-16" data-section="hero">
  {data.eyebrow && <p class="text-sm uppercase tracking-wide text-secondary mb-4">{data.eyebrow}</p>}
  <h1 class="font-heading text-5xl md:text-7xl leading-tight max-w-3xl">{data.headline}</h1>
  {data.subheadline && <p class="mt-6 text-lg md:text-xl text-secondary max-w-xl">{data.subheadline}</p>}
  {data.cta_label && (
    <a
      href={data.cta_href}
      class="mt-10 inline-flex w-fit items-center rounded-md bg-primary px-6 py-3 text-background transition-base hover:opacity-90"
    >
      {data.cta_label}
    </a>
  )}
</section>

---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';

const { data } = await getEntry('landing', '01-hero');
const [headlineLead, headlineTail] = data.headline.split(', ');
---
<section
  id="hero"
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-primary pb-8 pt-28 text-background md:min-h-dvh md:pb-12 md:pt-36"
  data-section="hero"
>
  <div class="absolute inset-0 -z-20 bg-primary"></div>
  <img
    src="/images/hero/camion-en-ruta.webp"
    alt="Imagen conceptual de un camión de carga circulando por una carretera montañosa de Antioquia"
    width="1672"
    height="941"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center]"
  />
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_70%_40%,rgba(148,194,61,.12),transparent_28%),linear-gradient(to_top,rgba(0,42,65,.98)_4%,rgba(0,42,65,.58)_48%,rgba(0,42,65,.22))]"></div>

  <div class="section-shell">
    <div class="md:grid md:grid-cols-[minmax(0,1fr)_13rem] md:items-end md:gap-8 lg:grid-cols-[1.45fr_0.55fr]">
      <h1 class="display-title max-w-[12ch] text-[clamp(3.75rem,17vw,7rem)] md:max-w-[10ch] md:text-[clamp(6rem,10vw,10rem)]">
        <span class="hero-reveal-item block">{headlineLead}</span>
        {headlineTail && <span class="hero-reveal-item block pl-[0.18em] text-accent md:pl-[0.42em]">{headlineTail}</span>}
      </h1>
      <div class="hero-reveal-item mt-5 md:mb-2 md:mt-0">
        {data.subheadline && <p class="body-copy max-w-[42ch] text-background/75">{data.subheadline}</p>}
        <div class="mt-6 flex flex-col items-start gap-5">
          {data.cta_label && (
            <a
              href={contact.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-lift inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-5 text-sm font-semibold text-primary md:min-h-14 md:w-full md:px-4 lg:w-auto lg:whitespace-nowrap lg:px-7"
            >
              {data.cta_label}
            </a>
          )}
          <a href="#que-hacemos" class="hidden items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-background/60 md:flex">
            Explora la operación <span class="flex h-10 w-10 items-center justify-center rounded-full border border-background/25">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

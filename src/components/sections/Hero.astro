---
import { getEntry } from 'astro:content';

const { data } = await getEntry('landing', '01-hero');
const [headlineLead, headlineTail] = data.headline.split(', ');
---
<section
  id="hero"
  class="relative isolate flex min-h-[100svh] flex-col justify-start overflow-hidden bg-primary pb-8 pt-28 text-background md:min-h-dvh md:pb-12 md:pt-36"
  data-section="hero"
>
  <div class="absolute inset-0 -z-20 bg-primary"></div>
  <img
    src="/images/hero/camion-en-ruta.webp"
    alt="Flota de camiones de G&S Conexiones Estratégicas alineada sobre una carretera de Antioquia"
    width="2000"
    height="1125"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_center]"
  />
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_bottom,rgba(0,0,0,.75)_0%,rgba(0,0,0,.42)_18%,rgba(0,0,0,.08)_38%,rgba(0,0,0,.08)_62%,rgba(0,0,0,.42)_82%,rgba(0,0,0,.75)_100%),linear-gradient(to_right,rgba(0,0,0,.62),rgba(0,0,0,.3)_34%,rgba(0,0,0,.06)_56%,transparent_70%)]"
  ></div>

  <div class="section-shell">
    <h1 class="display-title max-w-[34rem] text-[clamp(2.75rem,12vw,4rem)] md:text-[clamp(3rem,5.6vw,4.75rem)] lg:max-w-[42rem]">
      <span class="hero-reveal-item block">{headlineLead}</span>
      {headlineTail && <span class="hero-reveal-item block text-accent">{headlineTail}</span>}
    </h1>
  </div>

  <div class="section-shell mt-auto flex justify-center pt-10">
    <a
      href="#que-hacemos"
      aria-label="Explora la operación"
      class="hero-reveal-item flex h-12 w-12 items-center justify-center rounded-full border border-background/40 text-background/80 transition-colors duration-200 hover:border-background/70 hover:text-background md:h-14 md:w-14"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 md:h-7 md:w-7" aria-hidden="true">
        <path d="M12 4v16" />
        <path d="m5 13 7 7 7-7" />
      </svg>
    </a>
  </div>
</section>

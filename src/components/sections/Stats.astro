---
import { getEntry } from 'astro:content';
import { stats } from '../../data/stats';

const { data } = await getEntry('landing', '02-stats');
---
<section class="gsap-section px-6 py-20 md:px-16 md:py-24" data-section="stats">
  <!-- Headline oculta visualmente: solo aporta jerarquia de encabezados
       (h2) para SEO/a11y, el peso visual real son las 3 cifras. -->
  <h2 class="sr-only">{data.headline}</h2>
  <div class="mx-auto max-w-5xl rounded-2xl bg-primary px-6 py-8 md:px-4 md:py-10">
    <div class="grid grid-cols-1 divide-y divide-background/15 md:grid-cols-3 md:divide-x md:divide-y-0">
      {stats.map((stat) => (
        <div class="px-6 py-6 text-center md:py-0">
          <div class="font-heading text-4xl font-bold text-accent md:text-5xl">{stat.value}</div>
          <div class="mt-2 text-sm text-background/70">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

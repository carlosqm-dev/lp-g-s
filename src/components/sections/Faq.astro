---
import { getEntry } from 'astro:content';
const { data } = await getEntry('landing', '06-faq');
const faqs = [
  { q: 'Reemplaza con la objecion real #1', a: 'Respuesta directa, sin evasivas.' },
  { q: 'Reemplaza con la objecion real #2', a: 'Respuesta directa, sin evasivas.' },
];
---
<section id="faq" class="gsap-section px-6 md:px-16 py-24 md:py-32" data-section="faq">
  {data.eyebrow && <p class="text-sm uppercase tracking-wide text-secondary mb-4">{data.eyebrow}</p>}
  <h2 class="font-heading text-3xl md:text-5xl max-w-2xl mb-12">{data.headline}</h2>
  <div class="space-y-6 max-w-2xl">
    {faqs.map((item) => (
      <details class="border-b border-secondary/20 pb-4">
        <summary class="cursor-pointer font-heading text-lg">{item.q}</summary>
        <p class="mt-2 text-secondary">{item.a}</p>
      </details>
    ))}
  </div>
</section>

---
import { getEntry } from 'astro:content';
import { coverageCores } from '../../data/coverage';

const { data } = await getEntry('landing', '04-coverage');
---
<section id="cobertura" class="gsap-section px-6 py-20 md:px-16 md:py-24" data-section="coverage">
  <div class="mx-auto grid max-w-6xl gap-16 md:grid-cols-2">
    <div>
      <h2 class="font-heading text-3xl md:text-4xl">{data.headline}</h2>
      {data.subheadline && <p class="mt-3 text-secondary">{data.subheadline}</p>}
      <div class="mt-8 space-y-6">
        {coverageCores.map((core) => (
          <div class={`border-l-[3px] pl-4 ${core.variant === 'on-demand' ? 'border-secondary' : 'border-accent'}`}>
            <div class="text-xs font-bold uppercase tracking-wide text-secondary">{core.eyebrow}</div>
            <h3 class="font-heading text-xl">{core.title}</h3>
            <p class="mt-1 text-secondary">{core.description}</p>
          </div>
        ))}
      </div>
    </div>
    <div>
      <!-- Pendiente real (design-system/hierarchy.md): falta un SVG
           vectorial de los departamentos de Colombia. No inventar un
           mapa impreciso — placeholder etiquetado hasta tenerlo. -->
      <div class="flex min-h-[320px] items-center justify-center rounded-lg border border-dashed border-secondary/40 bg-background-alt p-6 text-center text-sm text-secondary">
        [Mapa de Colombia — Antioquia resaltada. Pendiente: SVG vectorial real]
      </div>
      <div class="mt-4 flex flex-wrap gap-5 text-sm">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-3 w-3 rounded-full bg-accent"></span>
          Base operativa: Antioquia
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-3 w-3 rounded-full border border-secondary bg-background-alt"></span>
          Cobertura nacional bajo requerimiento
        </span>
      </div>
    </div>
  </div>
</section>

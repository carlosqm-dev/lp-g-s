---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { coverageCores } from '../../data/coverage';
import mapaCobertura from '../../assets/map/colombia-cobertura.png';

const { data } = await getEntry('landing', '04-coverage');
---
<section id="cobertura" class="gsap-section px-6 py-20 md:px-16 md:py-24" data-section="coverage">
  <!-- La columna del mapa pesa mas que la del texto: la imagen necesita
       ancho para leerse y el texto gana al quedar mas compacto.
       `items-end` alinea el borde inferior del mapa con la ultima linea
       del bloque de texto, sin depender de alturas fijas. -->
  <div class="mx-auto grid max-w-6xl items-end gap-10 md:grid-cols-[1fr_1.7fr]">
    <div>
      <h2 class="font-heading text-3xl md:text-4xl">{data.headline}</h2>
      {data.subheadline && <p class="mt-3 text-secondary">{data.subheadline}</p>}
      <div class="mt-6 space-y-4">
        {coverageCores.map((core) => (
          <div class={`border-l-[3px] pl-4 ${core.variant === 'on-demand' ? 'border-secondary' : 'border-accent'}`}>
            <div class="text-xs font-bold uppercase tracking-wide text-secondary">{core.eyebrow}</div>
            <h3 class="font-heading text-xl leading-snug">{core.title}</h3>
            <p class="mt-1 text-secondary">{core.description}</p>
          </div>
        ))}
      </div>
    </div>
    <div>
      <!-- PNG con fondo transparente. Va por astro:assets para que el build
           genere WebP y reserve la caja (sin CLS); no se puede resaltar un
           departamento por CSS como con un SVG vectorial. -->
      <Image
        src={mapaCobertura}
        alt="Mapa de Colombia con Antioquia resaltada como base operativa y rutas de transporte hacia el resto del país"
        widths={[480, 768, 1152, 1536]}
        sizes="(min-width: 768px) 63vw, 100vw"
        format="webp"
        loading="lazy"
        decoding="async"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>

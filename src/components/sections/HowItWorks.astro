---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';
import { steps } from '../../data/steps';
import RouteMap from './RouteMap.astro';

const { data } = await getEntry('landing', '07-how-it-works');
---
<section class="gsap-section bg-accent py-20 text-primary md:py-32" data-section="how-it-works">
  <div class="section-shell">
    <div class="grid gap-6 border-b border-primary/25 pb-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-10 lg:pb-6">
      <div>
        <h2 class="display-title max-w-[9ch] text-6xl md:text-8xl lg:max-w-none lg:whitespace-nowrap">{data.headline}</h2>
      </div>
      <a
        href={contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-lift inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-primary px-5 text-sm font-semibold text-background lg:shrink-0"
      >
        Empieza por WhatsApp
      </a>
    </div>

    <RouteMap steps={steps} />
  </div>
</section>

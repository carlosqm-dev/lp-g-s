---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';
import { steps } from '../../data/steps';
import RouteMap from './RouteMap.astro';

const { data } = await getEntry('landing', '07-how-it-works');
---
<section class="gsap-section bg-accent py-20 text-primary md:py-32" data-section="how-it-works">
  <div class="section-shell">
    <div class="border-b border-primary/25 pb-8 text-center lg:pb-6">
      <h2 class="display-title mx-auto max-w-[9ch] text-6xl md:text-8xl lg:max-w-none lg:whitespace-nowrap">{data.headline}</h2>
    </div>

    <RouteMap steps={steps} />

    <div class="mt-8 flex justify-center">
      <a
        href={contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-lift inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-7 text-sm font-semibold text-primary-foreground"
      >
        Contáctanos
      </a>
    </div>
  </div>
</section>

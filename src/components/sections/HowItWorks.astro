---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';
import { steps } from '../../data/steps';

const { data } = await getEntry('landing', '07-how-it-works');
---
<section class="gsap-section bg-accent py-20 text-primary md:py-32" data-section="how-it-works">
  <div class="section-shell">
    <div class="grid gap-6 border-b border-primary/25 pb-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h2 class="display-title max-w-[9ch] text-6xl md:text-8xl">{data.headline}</h2>
      </div>
      <a
        href={contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-12 w-fit items-center gap-6 bg-primary px-5 text-sm font-semibold text-background transition-base hover:-translate-y-1"
      >
        Empieza por WhatsApp <span aria-hidden="true" class="text-xl transition-transform group-hover:translate-x-1">↗</span>
      </a>
    </div>

    <div class="process-track relative mt-10 md:mt-16 md:grid md:grid-cols-4 md:gap-px md:bg-primary/25">
      <span aria-hidden="true" class="process-line absolute bottom-0 left-[1.35rem] top-0 w-px origin-top bg-primary/30 md:left-0 md:right-0 md:top-[3.25rem] md:h-px md:w-auto"></span>
      {steps.map((step, index) => (
        <article class="process-step relative grid grid-cols-[3rem_1fr] gap-4 pb-10 md:block md:min-h-[22rem] md:bg-accent md:p-5">
          <span class="relative z-10 flex h-11 w-11 items-center justify-center border border-primary bg-accent font-heading text-lg font-bold transition-colors">{step.number}</span>
          <div class="md:mt-20">
            <span class="text-[9px] font-semibold uppercase tracking-[0.15em] text-primary/55">Fase 0{index + 1}</span>
            <h3 class="mt-2 max-w-[13ch] font-heading text-3xl font-semibold uppercase leading-[0.95] md:text-4xl">{step.title}</h3>
            <p class="mt-3 max-w-[28ch] text-sm leading-relaxed text-primary/70">{step.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';
import { steps } from '../../data/steps';

const { data } = await getEntry('landing', '07-how-it-works');
---
<section class="gsap-section px-6 py-20 md:px-16 md:py-24" data-section="how-it-works">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-heading text-3xl md:text-4xl">{data.headline}</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-4">
      {steps.map((step) => (
        <div class="rounded-lg border border-background-alt bg-background p-5">
          <span class="font-heading text-3xl font-bold text-accent">{step.number}</span>
          <h3 class="mt-3 font-heading text-lg">{step.title}</h3>
          <p class="mt-2 text-secondary">{step.description}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center">
      <a
        href={contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-md bg-accent px-6 py-3 font-heading font-semibold text-primary transition-base hover:opacity-90"
      >
        Empieza ahora por WhatsApp
      </a>
    </div>
  </div>
</section>

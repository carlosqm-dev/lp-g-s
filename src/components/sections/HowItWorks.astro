---
import { getEntry } from 'astro:content';
const { data } = await getEntry('landing', '04-how-it-works');
// Los pasos individuales no viven en el content collection porque su
// numero varia por cliente — defínelos aca o pasalos como prop.
const steps = [
  { title: 'Paso 1', description: 'Reemplaza con el primer paso real' },
  { title: 'Paso 2', description: 'Reemplaza con el segundo paso real' },
  { title: 'Paso 3', description: 'Reemplaza con el tercer paso real' },
];
---
<section id="como-funciona" class="gsap-section px-6 md:px-16 py-24 md:py-32" data-section="how-it-works">
  {data.eyebrow && <p class="text-sm uppercase tracking-wide text-secondary mb-4">{data.eyebrow}</p>}
  <h2 class="font-heading text-3xl md:text-5xl max-w-2xl mb-12">{data.headline}</h2>
  <div class="grid gap-8 md:grid-cols-3">
    {steps.map((step, i) => (
      <div class="rounded-lg border border-secondary/20 p-6">
        <span class="text-sm text-secondary">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="font-heading text-xl mt-2">{step.title}</h3>
        <p class="mt-2 text-secondary">{step.description}</p>
      </div>
    ))}
  </div>
</section>

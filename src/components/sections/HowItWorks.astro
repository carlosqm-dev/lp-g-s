---
import { getEntry } from 'astro:content';
import { contact } from '../../data/contact';
import { steps } from '../../data/steps';

const { data } = await getEntry('landing', '07-how-it-works');
---
<section class="gsap-section bg-accent py-20 text-primary md:py-32" data-section="how-it-works">
  <div class="section-shell">
    <div class="grid gap-6 border-b border-primary/25 pb-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h2 class="display-title max-w-[9ch] text-6xl md:text-8xl">{data.headline}</h2>
      </div>
      <a
        href={contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-12 w-fit items-center gap-6 bg-primary px-5 text-sm font-semibold text-background transition-base hover:-translate-y-1"
      >
        Empieza por WhatsApp <span aria-hidden="true" class="text-xl transition-transform group-hover:translate-x-1">↗</span>
      </a>
    </div>

    <div class="process-track mt-10 grid gap-12 md:mt-16 md:grid-cols-4 md:gap-6">
      {steps.map((step, index) => (
        <article class="process-step relative">
          <div class="group relative flex min-h-[18rem] items-center justify-center border border-background/15 bg-primary p-6 text-center text-background motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:hover:-translate-y-1 md:min-h-[22rem] md:p-5">
            <span aria-hidden="true" class="pointer-events-none absolute inset-3 overflow-hidden border border-accent/45 transition-colors duration-300 group-hover:border-background/45">
              <span class="absolute left-0 top-[-1px] h-px w-1/3 -translate-x-[120%] bg-background/90 opacity-0 motion-safe:transition-[transform,opacity] motion-safe:duration-700 motion-safe:ease-out motion-safe:group-hover:translate-x-[400%] motion-safe:group-hover:opacity-100"></span>
            </span>
            <div class="relative z-10 flex flex-col items-center">
              <h3 class="max-w-[13ch] font-heading text-3xl font-semibold uppercase leading-[0.95] text-background md:text-4xl">{step.title}</h3>
              <p class="mt-4 max-w-[28ch] text-sm leading-relaxed text-background/65">{step.description}</p>
            </div>
          </div>
          {index < steps.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute -bottom-9 left-1/2 z-20 flex h-6 w-6 -translate-x-1/2 items-center justify-center text-primary md:bottom-auto md:left-auto md:right-[-1.5rem] md:top-1/2 md:translate-x-0 md:-translate-y-1/2"
            >
              <svg viewBox="0 0 24 24" class="h-6 w-6 rotate-90 md:rotate-0" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

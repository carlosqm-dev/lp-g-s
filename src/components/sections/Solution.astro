---
import { getEntry } from 'astro:content';
const { data } = await getEntry('landing', '03-solution');
---
<section id="solucion" class="gsap-section px-6 md:px-16 py-24 md:py-32" data-section="solution">
  {data.eyebrow && <p class="text-sm uppercase tracking-wide text-secondary mb-4">{data.eyebrow}</p>}
  <h2 class="font-heading text-3xl md:text-5xl max-w-2xl">{data.headline}</h2>
  {data.subheadline && <p class="mt-4 text-lg text-secondary max-w-xl">{data.subheadline}</p>}
  <!-- Aca va el asset de producto: imagen o video, segun lo que haya
       marcado la fase 2 (jerarquia visual) en assets/images/product o
       assets/video/b-roll -->
  {data.cta_label && (
    <a href={data.cta_href} class="mt-8 inline-flex w-fit items-center rounded-md border border-primary px-6 py-3 text-primary transition-base hover:bg-primary hover:text-background">
      {data.cta_label}
    </a>
  )}
</section>

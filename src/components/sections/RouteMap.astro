---
import type { Step } from '../../data/steps';

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

const desktopPositions = [
  'left-[13%] top-1/2',
  'left-[37%] top-1/2',
  'left-[63%] top-1/2',
  'left-[87%] top-1/2',
];

const mobilePositions = ['top-[17%]', 'top-[39%]', 'top-[61%]', 'top-[83%]'];
---

<div class="route-map relative left-1/2 mt-10 w-screen -translate-x-1/2 bg-accent lg:mt-12" aria-label="Ruta del servicio en cuatro etapas">
  <div class="route-layout-mobile relative h-[72rem] lg:hidden">
    <svg aria-hidden="true" viewBox="0 0 420 1200" preserveAspectRatio="none" class="absolute inset-0 h-full w-full">
      <path
        class="route-shoulder fill-none stroke-background/45"
        d="M210 60 L210 1140"
        stroke-width="355"
        stroke-linecap="butt"
      />
      <path
        class="route-road fill-none stroke-primary"
        d="M210 60 L210 1140"
        stroke-width="330"
        stroke-linecap="butt"
      />
      <path
        class="route-centerline fill-none stroke-accent/75"
        d="M210 60 L210 1140"
        stroke-width="5"
        stroke-linecap="butt"
        stroke-dasharray="16 18"
      />
    </svg>

    <ol class="absolute inset-0">
      {steps.map((step, index) => (
        <li class={`absolute left-1/2 z-10 flex w-[15rem] -translate-x-1/2 -translate-y-1/2 flex-col items-center text-center ${mobilePositions[index]}`}>
          <div class="process-step w-full rounded-[2rem] border border-primary/10 bg-white px-4 py-5 shadow-lg">
            <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border-2 border-primary bg-accent font-heading text-lg font-bold text-primary ring-4 ring-primary/85">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 font-heading text-2xl font-semibold uppercase leading-[0.92] text-primary">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-secondary">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="route-layout-desktop relative hidden h-[32rem] lg:block">
    <svg aria-hidden="true" viewBox="0 0 1440 448" preserveAspectRatio="none" class="absolute inset-0 h-full w-full">
      <path
        class="route-shoulder fill-none stroke-background/45"
        d="M0 224 H1440"
        stroke-width="426"
        stroke-linecap="butt"
      />
      <path
        class="route-road fill-none stroke-primary"
        d="M0 224 H1440"
        stroke-width="400"
        stroke-linecap="butt"
      />
      <path
        class="route-centerline fill-none stroke-accent/75"
        d="M0 224 H1440"
        stroke-width="5"
        stroke-linecap="butt"
        stroke-dasharray="18 20"
      />
    </svg>

    <ol class="absolute inset-0">
      {steps.map((step, index) => (
        <li class={`absolute z-10 flex w-[22%] max-w-[16rem] -translate-x-1/2 -translate-y-1/2 flex-col items-center text-center ${desktopPositions[index]}`}>
          <div class="process-step min-h-64 w-full rounded-[2rem] border border-primary/10 bg-white px-5 py-7 shadow-lg">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary bg-accent font-heading text-xl font-bold text-primary ring-4 ring-primary/85">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 font-heading text-2xl font-semibold uppercase leading-[0.92] text-primary xl:text-3xl">{step.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-secondary">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

---
import { getEntry } from 'astro:content';
import { services } from '../../data/services';

const { data } = await getEntry('landing', '03-what-we-do');
---
<section id="que-hacemos" class="gsap-section bg-background-alt px-6 py-20 md:px-16 md:py-24" data-section="what-we-do">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-heading text-3xl md:text-4xl">{data.headline}</h2>
    {data.subheadline && <p class="mt-3 max-w-2xl text-secondary">{data.subheadline}</p>}
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <div class="rounded-lg border border-background-alt bg-background p-6">
          <div class="mb-4 flex min-h-[140px] items-center justify-center rounded-md border border-dashed border-secondary/40 bg-background-alt text-center text-xs text-secondary">
            [Imagen — ver assets/images/shot-list.md]
          </div>
          <h3 class="font-heading text-xl">{service.title}</h3>
          <p class="mt-2 text-secondary">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

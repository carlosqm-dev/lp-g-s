---
import { getEntry } from 'astro:content';
import { milestones, foundersQuote } from '../../data/history';

const { data } = await getEntry('landing', '08-history');
---
<section id="historia" class="gsap-section overflow-hidden bg-background py-20 md:py-32" data-section="history">
  <div class="section-shell">
    <div class="grid gap-8 border-b border-primary/20 pb-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <h2 class="display-title max-w-[10ch] text-6xl md:text-8xl">{data.headline}</h2>
      </div>
      {data.subheadline && <p class="body-copy max-w-[45ch] text-secondary lg:justify-self-end">{data.subheadline}</p>}
    </div>

    <div class="mt-10 grid gap-px bg-primary/20 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col gap-px bg-primary/20">
        <div class="history-visual relative isolate min-h-[27rem] overflow-hidden bg-primary text-background md:min-h-[38rem]">
          <img
            src="/images/historia/fundadores-conceptual.webp"
            alt="Imagen conceptual de un padre y su hijo trabajando juntos junto a un camión"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 h-full w-full object-cover object-[54%_center]"
          />
          <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(0,42,65,.94),rgba(0,42,65,.08)_68%)]"></div>
          <p class="absolute inset-x-5 bottom-5 max-w-[23ch] font-heading text-3xl font-semibold uppercase leading-[0.95] text-background md:text-4xl">Dos generaciones. Una misma ruta.</p>
        </div>
        <blockquote class="bg-background-alt p-6 font-heading text-3xl font-semibold uppercase leading-[0.95] md:p-8 md:text-5xl">“{foundersQuote.text}”</blockquote>
      </div>

      <div class="bg-background p-5 md:p-8">
        <div class="history-track border-t border-primary/20">
          {milestones.map((milestone) => (
            <article class="history-item border-b border-primary/20 py-6">
              <div class="flex flex-wrap items-center gap-2 text-[9px] font-semibold uppercase tracking-[0.14em] text-secondary">
                {milestone.eyebrow}
                {!milestone.dateConfirmed && <span class="border border-primary/20 px-1.5 py-0.5 text-[8px]">Fecha por confirmar</span>}
              </div>
              <p class="body-copy mt-2 max-w-[44ch] text-secondary">{milestone.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

---
// Pantalla de carga. El comportamiento (conteo, salida en cortina
// diagonal) vive en src/animations/preloader.ts — este componente es
// solo el markup + el estado visual base/leaving.
---
<div
  id="preloader"
  class="fixed inset-0 z-[100] flex items-end justify-between bg-background px-8 py-16 md:px-24"
  style="clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%); transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);"
  aria-hidden="true"
>
  <div
    class="preloader-percent font-heading font-bold text-primary"
    style="font-size: clamp(80px, 15vw, 160px); line-height: 1;"
  >
    0
  </div>
  <svg class="preloader-truck h-[60px] w-[120px]" viewBox="0 0 120 60" aria-hidden="true">
    <rect x="2" y="24" width="60" height="24" rx="3" fill="#94C23D" />
    <path d="M62 30h20l16 14v4H62z" fill="#94C23D" />
    <circle class="wheel" cx="20" cy="50" r="7" fill="#002A41" />
    <circle class="wheel" cx="52" cy="50" r="7" fill="#002A41" />
    <circle class="wheel" cx="90" cy="50" r="7" fill="#002A41" />
  </svg>
</div>

<style>
  #preloader.is-leaving {
    transform: translateY(-110%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader {
      display: none !important;
    }
  }
</style>

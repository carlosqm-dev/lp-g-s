---
// Pantalla de carga. El comportamiento (temporizado, salida en cortina
// diagonal) vive en src/animations/preloader.ts — este componente es
// solo el markup + el estado visual base/leaving.
---
<div
  id="preloader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-2 bg-white"
  aria-hidden="true"
>
  <img
    src="/brand/logo-horizontal.png"
    alt="G&S Conexiones Estratégicas"
    class="h-16 w-auto md:h-20"
  />
  <p class="preloader-text font-heading text-xl font-medium text-primary md:text-2xl">
    Cargando...
  </p>
</div>

<style>
  .preloader-text {
    animation: preloader-pulse 1.2s ease-in-out infinite;
  }

  @keyframes preloader-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  #preloader {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    transition:
      transform 0.9s cubic-bezier(0.76, 0, 0.24, 1),
      clip-path 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  #preloader.is-leaving {
    clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
    transform: translateY(-110%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader {
      display: none !important;
    }
  }
</style>

---
// Pantalla de carga. El comportamiento (temporizado, salida en cortina
// diagonal) vive en src/animations/preloader.ts — este componente es
// solo el markup + el estado visual base/leaving.
---
<div
  id="preloader"
  class="industrial-grid fixed inset-0 z-[100] flex flex-col items-center justify-center gap-5 bg-primary text-background"
  aria-hidden="true"
>
  <img
    src="/brand/logo-horizontal-white.png"
    alt="G&S Conexiones Estratégicas"
    class="h-14 w-auto md:h-20"
  />
  <div class="flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-background/60">
    <span>Origen</span>
    <span class="preloader-line h-px w-20 bg-accent"></span>
    <span>Destino</span>
  </div>
</div>

<style>
  .preloader-line {
    transform-origin: left;
    animation: preloader-progress 1.2s ease-in-out infinite;
  }

  @keyframes preloader-progress {
    0% { transform: scaleX(0.08); opacity: 0.45; }
    55% { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; transform-origin: right; }
  }

  #preloader {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    transition:
      transform 0.9s cubic-bezier(0.76, 0, 0.24, 1),
      clip-path 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  #preloader.is-leaving {
    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
    transform: translateY(-110%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader {
      display: none !important;
    }
  }
</style>

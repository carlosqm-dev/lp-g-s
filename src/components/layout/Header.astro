---
// Header fijo, transparente sobre el Hero. Pasa a liquid glass navy al
// hacer scroll — el toggle de la clase `.is-scrolled` vive en
// src/animations/header-scroll.ts (GSAP ScrollTrigger).
//
// Mismo grid de 3 columnas en los dos breakpoints (izquierda / centro /
// derecha); solo cambia quien ocupa cada celda:
//   escritorio -> nav        | logo horizontal | CTA
//   mobile     -> hamburguesa| isotipo         | CTA
// Los accesos de mobile caen en una tarjeta flotante bajo el header.
// Comportamiento del menu: src/animations/header-menu.ts.
import { contact } from '../../data/contact';
import { navLinks } from '../../data/nav';
---
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border border-transparent transition-all duration-300"
>
  <!-- A diferencia de las secciones, el header no se acota a max-w-6xl:
       ocupa todo el ancho para que los accesos arranquen pegados al borde
       y quede aire entre ellos y el logo centrado. -->
  <div class="grid grid-cols-[1fr_auto_1fr] items-center px-6 py-4 md:px-10">
    <button
      id="menu-toggle"
      type="button"
      class="menu-toggle -ml-2 flex h-10 w-10 items-center justify-center justify-self-start md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-toggle-bars relative block h-3.5 w-6" aria-hidden="true">
        <span class="menu-bar menu-bar-top"></span>
        <span class="menu-bar menu-bar-mid"></span>
        <span class="menu-bar menu-bar-bottom"></span>
      </span>
    </button>

    <nav class="header-nav hidden items-center gap-6 justify-self-start md:flex" aria-label="Principal">
      {navLinks.map((link) => (
        <a href={link.href} class="header-nav-link relative text-sm font-bold transition-colors duration-300">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Una sola version blanca de cada logo: el header es oscuro tanto
         sobre el Hero como en glass, asi que ya no hace falta el par
         blanco/negro con crossfade. -->
    <a href="#hero" class="block h-11 w-11 justify-self-center md:hidden" aria-label="G&S Conexiones Estratégicas — inicio">
      <img src="/brand/isotipo-white.png" alt="" aria-hidden="true" class="h-full w-full object-contain" />
    </a>

    <a href="#hero" class="hidden aspect-[640/312] justify-self-center md:block md:h-14">
      <img
        src="/brand/logo-horizontal-white.png"
        alt="G&S Conexiones Estratégicas"
        class="h-full w-full object-contain"
      />
    </a>

    <a
      href={contact.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="justify-self-end rounded-full bg-accent px-5 py-2 text-sm font-bold text-primary transition-base hover:opacity-90"
    >
      Contacto
    </a>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu absolute inset-x-4 top-full flex flex-col rounded-3xl border px-6 py-3 md:hidden"
  >
    <nav class="flex flex-col" aria-label="Menú móvil">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-menu-link py-4 text-xl text-background/90 transition-colors duration-200">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header-nav a {
    color: var(--color-background);
  }

  .header-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-standard);
  }

  .header-nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Al hacer scroll el header pasa a liquid glass navy, la misma receta
     del panel movil: navy translucido + blur con saturate para que el
     fondo se funda en vez de verse gris, borde claro y highlight inset
     de 1px que simula el canto de vidrio. Al ser oscuro, el logo y los
     enlaces se quedan en blanco: no hay crossfade a la version negra. */
  #site-header.is-scrolled {
    /* El margen despega la barra de los bordes para que se lea como una
       pastilla flotante; el radio grande la cierra por completo. */
    margin: 0.75rem 1rem;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    border-color: color-mix(in srgb, var(--color-background) 22%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 12px 32px -12px color-mix(in srgb, var(--color-primary) 45%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-background) 28%, transparent);
  }

  /* Isotipo y hamburguesa van sueltos sobre el header, sin contenedor
     propio, y en blanco en los dos estados: el glass navy no necesita
     invertirlos. */
  .menu-toggle {
    color: var(--color-background);
  }

  /* --- Boton hamburguesa: 3 barras que se cruzan en X al abrir --- */
  .menu-bar {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    background-color: currentColor;
    transition:
      transform 0.3s var(--ease-standard),
      opacity 0.2s var(--ease-standard);
  }

  .menu-bar-top {
    top: 0;
  }

  .menu-bar-mid {
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-bar-bottom {
    bottom: 0;
  }

  #site-header.menu-open .menu-bar-top {
    transform: translateY(6px) rotate(45deg);
  }

  #site-header.menu-open .menu-bar-mid {
    opacity: 0;
  }

  #site-header.menu-open .menu-bar-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* --- Tarjeta flotante de navegacion (mobile), navy en liquid glass ---
     El navy translucido deja pasar el fondo; el blur + saturate lo funden
     y el borde/highlight superior simulan el canto de vidrio. */
  .mobile-menu {
    border-color: color-mix(in srgb, var(--color-background) 22%, transparent);
    background-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 24px 48px -12px color-mix(in srgb, var(--color-primary) 45%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-background) 28%, transparent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.3s var(--ease-standard),
      transform 0.3s var(--ease-standard),
      visibility 0.3s;
  }

  #site-header.menu-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-menu-link:active {
    color: var(--color-accent);
  }
</style>
